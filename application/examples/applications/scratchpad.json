{
  "format": "morphz-app/v1",
  "id": "example.scratchpad",
  "version": "1.1.1",
  "title": "工作便笺",
  "description": "记下想法，保存为文档，或交给 Morphz 继续整理。",
  "icon": "document",
  "permissions": ["artifacts.read", "artifacts.write", "input.compose"],
  "harness": null,
  "ui": {
    "type": "sandbox",
    "html": "<!doctype html><html lang='zh-CN'><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>工作便笺</title><style>:root{color-scheme:light dark}*{box-sizing:border-box}body{margin:0;padding:36px;font:14px/1.7 system-ui;color:light-dark(#222,#eee);background:light-dark(#fff,#202020)}main{max-width:780px;margin:auto}small,#status{color:light-dark(#777,#aaa)}h1{font-size:26px;font-weight:600;margin:8px 0 24px}textarea{width:100%;height:230px;resize:vertical;border:1px solid light-dark(#ddd,#444);border-radius:10px;padding:18px;font:15px/1.8 system-ui;background:light-dark(#fafafa,#262626);color:inherit}button{padding:9px 14px;margin:16px 8px 12px 0;border:1px solid light-dark(#ddd,#444);border-radius:8px;background:transparent;color:inherit;cursor:pointer}button:hover{background:light-dark(#f4f4f4,#303030)}button:disabled{opacity:.4}#status{min-height:24px}li button{margin:4px;padding:5px 10px}p{margin:12px 0}</style><main><small>认知应用 · 宿主协议示例</small><h1>工作便笺</h1><label for='note'>先记下想法，再交给 Morphz 一起推进。</label><textarea id='note' placeholder='写下此刻的想法…'></textarea><div><button id='save'>保存便笺状态</button><button id='create'>保存为文档</button><button id='compose'>交给 Morphz</button></div><p id='status' role='status'>正在连接工作空间…</p><small id='location'></small><h2>这个工作空间的对象</h2><ul id='objects'></ul></main><script>let channel,context,ready=false,connecting=false,dirty=false,busy=false;const pending=new Map();const note=document.querySelector('#note'),status=document.querySelector('#status');function request(data){if(!channel)return Promise.reject(new Error('宿主尚未连接'));return new Promise((resolve,reject)=>{const requestId=crypto.randomUUID();const timer=setTimeout(()=>{pending.delete(requestId);reject(new Error('回执未确认，请先查看状态，不要重复保存为文档。'))},10000);pending.set(requestId,{resolve,reject,timer});parent.postMessage({type:'morphz-app:request',channel,requestId,request:data},'*')})}function update(value){context=value;document.documentElement.style.colorScheme=value.theme?.appearance==='dark'?'dark':value.theme?.appearance==='light'?'light':'light dark';document.querySelector('#location').textContent=value.workspaceTitle;if(!dirty)note.value=value.state.note||'';document.querySelectorAll('button').forEach(b=>b.disabled=busy||!ready||!value.active);const list=document.querySelector('#objects');list.replaceChildren();for(const a of value.artifacts){const li=document.createElement('li'),b=document.createElement('button');b.textContent=a.title;b.onclick=()=>request({method:'openArtifact',artifactId:a.id});li.append(b);list.append(li)}}addEventListener('message',e=>{if(e.source!==parent)return;const m=e.data;if(m.type==='morphz-app:init'){channel=m.channel;update(m.context);if(!ready&&!connecting&&m.context.active){connecting=true;request({method:'ready'}).then(()=>{ready=true;update(context);status.textContent='已连接；这份便笺尚未发送给 Agent。'}).catch(e=>{connecting=false;status.textContent=e.message})}}else if(m.type==='morphz-app:response'&&m.channel===channel){const p=pending.get(m.requestId);if(!p)return;clearTimeout(p.timer);pending.delete(m.requestId);if(m.context)update(m.context);m.error?p.reject(new Error(m.error)):p.resolve(m.result)}});note.oninput=()=>{dirty=true;status.textContent='便笺有未保存的修改。'};async function action(fn){if(busy||!ready)return;busy=true;document.querySelectorAll('button').forEach(b=>b.disabled=true);try{await fn()}catch(e){status.textContent=e.message}finally{busy=false;document.querySelectorAll('button').forEach(b=>b.disabled=!context?.active)}}document.querySelector('#save').onclick=()=>action(async()=>{await request({method:'saveState',expectedRevision:context.revision,state:{...context.state,note:note.value}});dirty=false;status.textContent='便笺状态已保存；关闭后可恢复。'});document.querySelector('#create').onclick=()=>action(async()=>{if(!note.value.trim())throw new Error('请先写下内容。');await request({method:'command',operation:{type:'create-artifact',projectId:context.workspaceId,title:'工作便笺',content:{kind:'document',markdown:note.value}}});status.textContent='文档已保存到工作空间。'});document.querySelector('#compose').onclick=()=>action(async()=>{await request({method:'compose',text:note.value});status.textContent='已放入输入框，请检查后发送。'});</script></html>"
  }
}
