{
  "format": "morphz-app/v1",
  "id": "example.scratchpad",
  "version": "1.3.0",
  "title": "工作便笺",
  "description": "临时记下想法，保存为文档，或交给 Morphz 继续整理。",
  "icon": "document",
  "permissions": ["artifacts.read", "artifacts.write", "input.compose"],
  "harness": null,
  "ui": {
    "type": "sandbox",
    "html": "<!doctype html><html lang='zh-CN'><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>工作便笺</title><style>:root{color-scheme:light dark}*{box-sizing:border-box}body{margin:0;padding:36px;font:14px/1.7 system-ui;color:light-dark(#222,#eee);background:light-dark(#fff,#202020)}main{max-width:780px;margin:auto}small,#status{color:light-dark(#777,#aaa)}h1{font-size:26px;font-weight:600;margin:8px 0 24px}textarea{width:100%;height:230px;resize:vertical;border:1px solid light-dark(#ddd,#444);border-radius:10px;padding:18px;font:15px/1.8 system-ui;background:light-dark(#fafafa,#262626);color:inherit}button{padding:9px 14px;margin:16px 8px 12px 0;border:1px solid light-dark(#ddd,#444);border-radius:8px;background:transparent;color:inherit;cursor:pointer}button:hover{background:light-dark(#f4f4f4,#303030)}button:disabled{opacity:.4}#status{min-height:24px}li button{margin:4px;padding:5px 10px}p{margin:12px 0}</style><main><small>认知应用 · 宿主协议示例</small><h1>工作便笺</h1><label for='note'>先记下想法；保存为文档后才会持久保留。</label><textarea id='note' placeholder='写下此刻的想法…'></textarea><div><button id='create'>保存为文档</button><button id='compose'>交给 Morphz</button></div><p id='status' role='status'>正在连接工作空间…</p><small id='location'></small><h2>这个工作空间的对象</h2><ul id='objects'></ul></main><script>let channel, context, ready = false, connecting = false, busy = false;\nlet artifactId = null, artifactRevision = 0, artifactTitle = '工作便笺', savedText = '', pendingWrite = null;\nconst pending = new Map(), note = document.querySelector('#note'), status = document.querySelector('#status');\nnote.disabled = true;\nfunction request(data, requestId = crypto.randomUUID()) {\n  if (!channel) return Promise.reject(new Error('宿主尚未连接'));\n  return new Promise((resolve, reject) => {\n    const timer = setTimeout(() => {\n      pending.delete(requestId);\n      reject(new Error('回执未确认；再次保存会核对同一次操作，请勿关闭。'));\n    }, 10000);\n    pending.set(requestId, {resolve, reject, timer});\n    parent.postMessage({type:'morphz-app:request', channel, requestId, request:data}, '*');\n  });\n}\nfunction update(value) {\n  context = value;\n  document.documentElement.style.colorScheme = value.theme?.appearance === 'dark' ? 'dark' : 'light dark';\n  document.querySelector('#location').textContent = value.workspaceTitle;\n  document.querySelectorAll('button').forEach(b => b.disabled = busy || !ready || !value.active);\n  note.disabled = !ready || !value.active;\n  const list = document.querySelector('#objects');\n  list.replaceChildren();\n  for (const a of value.artifacts) {\n    const li = document.createElement('li'), b = document.createElement('button');\n    b.textContent = a.title;\n    b.disabled = busy || !ready || !value.active;\n    b.onclick = () => request({method:'openArtifact', artifactId:a.id});\n    li.append(b); list.append(li);\n  }\n}\nasync function restore() {\n  const id = context.state?.artifactId;\n  if (!id) {\n    status.textContent = '已连接；这段文字尚未保存。';\n    return;\n  }\n  const original = await request({method:'readArtifact', artifactId:id});\n  if (original.id !== id || original.content?.kind !== 'document')\n    throw new Error('保存的文档暂时无法打开。');\n  artifactId = id; artifactRevision = original.revision; artifactTitle = original.title;\n  savedText = original.content.markdown; note.value = savedText;\n  status.textContent = '已连接；已恢复保存的文档。';\n}\naddEventListener('message', e => {\n  if (e.source !== parent) return;\n  const m = e.data;\n  if (m.type === 'morphz-app:init') {\n    channel = m.channel; update(m.context);\n    if (!ready && !connecting && m.context.active) {\n      connecting = true;\n      request({method:'ready'}).then(restore).then(() => {\n        ready = true; update(context);\n      }).catch(error => {status.textContent = error.message;}).finally(() => {connecting = false;});\n    }\n  } else if (m.type === 'morphz-app:response' && m.channel === channel) {\n    const p = pending.get(m.requestId); if (!p) return;\n    clearTimeout(p.timer); pending.delete(m.requestId);\n    if (m.context) update(m.context);\n    m.error ? p.reject(new Error(m.error)) : p.resolve(m.result);\n  }\n});\nnote.oninput = () => {status.textContent = '这段文字尚未保存。';};\nasync function action(fn) {\n  if (busy || !ready) return;\n  busy = true; update(context);\n  try {await fn();} catch (error) {status.textContent = error.message;}\n  finally {busy = false; update(context);}\n}\ndocument.querySelector('#create').onclick = () => action(async () => {\n  if (!note.value.trim()) throw new Error('请先写下内容。');\n  if (!pendingWrite && (!artifactId || note.value !== savedText)) {\n    pendingWrite = {\n      requestId:crypto.randomUUID(),\n      revision:artifactId ? artifactRevision + 1 : 1,\n      text:note.value,\n      data:{method:'command', operation:artifactId\n        ? {type:'revise-artifact', artifactId, expectedRevision:artifactRevision, title:artifactTitle, content:{kind:'document', markdown:note.value}}\n        : {type:'create-artifact', projectId:context.workspaceId, title:artifactTitle, content:{kind:'document', markdown:note.value}}}\n    };\n  }\n  if (pendingWrite) {\n    const write = pendingWrite;\n    const receipt = await request(write.data, write.requestId);\n    const original = await request({method:'readArtifact', artifactId:receipt.entityId, revision:write.revision});\n    if (original.id !== receipt.entityId || original.revision !== write.revision ||\n        original.content?.kind !== 'document' || original.content.markdown !== write.text)\n      throw new Error('文档回执与原件不一致，请重试核对。');\n    artifactId = original.id; artifactRevision = original.revision; artifactTitle = original.title;\n    savedText = original.content.markdown; pendingWrite = null;\n  }\n  try {\n    await request({method:'saveState', expectedRevision:context.revision, state:{artifactId}});\n  } catch (error) {\n    throw new Error('文档已保存；恢复入口未保存，请重试。' + error.message);\n  }\n  status.textContent = note.value === savedText\n    ? '文档已保存到工作空间。' : '文档已保存；新修改尚未保存。';\n});\ndocument.querySelector('#compose').onclick = () => action(async () => {\n  await request({method:'compose', text:note.value});\n  status.textContent = '已放入输入框，请检查后发送。';\n});</script></html>"
  }
}
