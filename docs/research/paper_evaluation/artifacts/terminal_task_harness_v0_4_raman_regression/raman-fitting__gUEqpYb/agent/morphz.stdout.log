{
  "command": "python - <<'PY'\nfrom pathlib import Path\nr=[]\nfor line in Path('/app/graphene.dat').read_text().splitlines():\n a,b=line.split('\\t'); r.append((float(a.replace(',','.')),float(b.replace(',','.'))))\n# equal-width bins means/std\nfor lo,hi,w in [(2400,3100,10),(1600,1850,5),(15000,18000,100)]:\n print('\\nBINS',lo,hi,w)\n k=lo\n while k<hi:\n  ys=[y for x,y in r if k<=x<k+w]\n  if ys:\n   m=sum(ys)/len(ys); sd=(sum((v-m)**2 for v in ys)/len(ys))**.5\n   print(f'{k+w/2:9.1f} n={len(ys):3d} mean={m:9.2f} sd={sd:8.2f}')\n  k+=w\nPY",
  "cwd": "/app",
  "wait_ms": 10000
}
