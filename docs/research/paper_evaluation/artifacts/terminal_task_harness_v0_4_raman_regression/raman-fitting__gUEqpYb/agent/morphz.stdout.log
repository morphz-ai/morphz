{
  "command": "cat > /tmp/analyze.py <<'PY'\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.optimize import least_squares, curve_fit\nfrom scipy.signal import find_peaks\n\nrows=[]\nfor line in Path('/app/graphene.dat').read_text().splitlines():\n    a,b=line.split('\\t'); rows.append((float(a.replace(',','.')),float(b.replace(',','.'))))\na=np.array(rows); x=a[:,0]; y=a[:,1]\n# ascending for convenience\nq=np.argsort(x); x=x[q]; y=y[q]\n\ndef lor(x,x0,g,A): return A*g*g/((x-x0)**2+g*g)\ndef model3(p,x):\n    c=p[0]\n    out=np.full_like(x,c)\n    for j in range(3):\n        x0,g,A=p[1+3*j:4+3*j]\n        out += lor(x,x0,g,A)\n    return out\n\nfor lo,hi in [(14500,21000),(15000,20500),(15500,20500),(14500,20000),(15000,20000)]:\n    m=(x>=lo)&(x<=hi); xx=x[m]; yy=y[m]\n    p0=np.array([13000, 16250,150,3000, 17650,150,7000, 19200,500,70000],float)\n    lb=[0,15800,10,0,16800,10,0,18500,10,0]\n    ub=[30000,16800,1000,30000,18200,1000,50000,19800,3000,120000]\n    sc=np.maximum(np.abs(p0),1)\n    r=least_squares(lambda p:(model3(p,xx)-yy),p0,bounds=(lb,ub),x_scale=sc,max_nfev=100000)\n    pred=model3(r.x,xx); rmse=np.sqrt(np.mean((pred-yy)**2))\n    print('\\nwindow',lo,hi,'n',len(xx),'success',r.success,'cost',r.cost,'rmse',rmse)\n    print(r.x)\n    for xi,yi,pi in zip(xx,yy,pred): print(f'{xi:10.2f} {yi:10.1f} pred {pi:10.1f} res {yi-pi:9.1f}')\n\n# Fit only 2D on baseline linear/quadratic in candidate windows\n\ndef mod_peak(p,xx,order):\n    xref=xx.mean(); z=(xx-xref)/1000\n    out=p[0]+p[1]*z\n    idx=2\n    if order>=2: out+=p[2]*z*z; idx=3\n    x0,g,A=p[idx:idx+3]\n    return out+lor(xx,x0,g,A)\nfor name,cen, windows in [('2D',16250,[(15000,17000),(15200,17000),(15500,16900),(15700,16800),(15800,16700)]),('G',17600,[(16500,18500),(16800,18500),(17000,18500),(16800,18200),(17000,18100)])]:\n print('\\n###',name)\n for lo,hi in windows:\n  m=(x>=lo)&(x<=hi);xx=x[m];yy=y[m]\n  for order in [1,2]:\n   if name=='2D': bounds=([-1e5,-1e5]+([-1e5] if order==2 else [])+[15800,10,0],[1e5,1e5]+([1e5] if order==2 else [])+[16800,1000,50000])\n   else: bounds=([-1e5,-1e5]+([-1e5] if order==2 else [])+[16800,10,0],[1e5,1e5]+([1e5] if order==2 else [])+[18200,1000,50000])\n   p0=[np.median(yy), (yy[-1]-yy[0])/((xx[-1]-xx[0])/1000)] + ([0] if order==2 else []) + [cen,150,max(1000,yy.max()-yy.min())]\n   r=least_squares(lambda p:mod_peak(p,xx,order)-yy,p0,bounds=bounds,x_scale='jac',max_nfev=100000)\n   rmse=np.sqrt(np.mean((mod_peak(r.x,xx,order)-yy)**2))\n   print('win',lo,hi,'ord',order,'n',len(xx),'rmse',round(rmse,2),'p',np.round(r.x,3))\nPY\npython /tmp/analyze.py > /tmp/analyze.out\nsed -n '1,260p' /tmp/analyze.out",
  "cwd": "/app",
  "wait_ms": 10000
}
