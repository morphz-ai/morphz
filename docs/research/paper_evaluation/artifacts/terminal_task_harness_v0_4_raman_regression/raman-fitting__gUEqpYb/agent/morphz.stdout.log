{
  "command": "cat > /tmp/fits.py <<'PY'\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.optimize import least_squares\n\nrows=[]\nfor line in Path('/app/graphene.dat').read_text().splitlines():\n a,b=line.split('\\t'); rows.append((float(a.replace(',','.')),float(b.replace(',','.'))))\na=np.array(rows); x=a[:,0]; y=a[:,1]; q=np.argsort(x); x=x[q];y=y[q]\n\ndef L(x,c,g,A): return A*g*g/((x-c)**2+g*g)\n\ndef model(p,x,order=1, comps=3):\n z=(x-18000)/5000\n out=np.zeros_like(x)\n for k in range(order+1): out += p[k]*z**k\n j=order+1\n for n in range(comps):\n  c,g,A=p[j:j+3]; j+=3; out+=L(x,c,g,A)\n return out\n\n# baseline + peaks 2D,G,laser. Vary all setup.\nfor win in [(13000,22000),(14000,22000),(14500,21500),(15000,21000),(15000,22000),(12000,23000)]:\n for order in [0,1,2,3]:\n  m=(x>=win[0])&(x<=win[1]); xx=x[m];yy=y[m]\n  # p bg, 2D, G, laser\n  bg=[10000]+[0]*order\n  p0=np.array(bg+[16200,180,2500,17600,120,1500,19200,400,68000],float)\n  lobg=[-1e5]*(order+1); hibg=[1e5]*(order+1)\n  lb=np.array(lobg+[15800,20,0,17100,20,0,18800,50,0],float)\n  ub=np.array(hibg+[16600,800,30000,18100,800,30000,19600,1500,150000],float)\n  for loss in ['linear','soft_l1']:\n   r=least_squares(lambda p:model(p,xx,order)-yy,p0,bounds=(lb,ub),x_scale='jac',loss=loss,f_scale=300,max_nfev=200000)\n   pred=model(r.x,xx,order); rmse=float(np.sqrt(np.mean((pred-yy)**2)))\n   j=order+1; pars=r.x[j:]\n   print('win',win,'ord',order,'loss',loss,'n',len(xx),'rmse',round(rmse,1),\n         '2D',np.round(pars[0:3],1),'G',np.round(pars[3:6],1),'R',np.round(pars[6:9],1),'bg',np.round(r.x[:j],1))\n print()\nPY\npython /tmp/fits.py",
  "cwd": "/app",
  "wait_ms": 10000
}
