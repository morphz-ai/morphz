{
  "command": "cat > /tmp/analyze.py <<'PY'\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.optimize import least_squares\n\nrows=[]\nfor line in Path('/app/graphene.dat').read_text().splitlines():\n    a,b=line.split('\\t'); rows.append((float(a.replace(',','.')),float(b.replace(',','.'))))\na=np.array(rows); x=a[:,0]; y=a[:,1]\nq=np.argsort(x); x=x[q]; y=y[q]\n\ndef lor(x,x0,g,A): return A*g*g/((x-x0)**2+g*g)\ndef model3(p,x):\n    c=p[0]\n    out=np.full_like(x,c)\n    for j in range(3):\n        x0,g,A=p[1+3*j:4+3*j]\n        out += lor(x,x0,g,A)\n    return out\n\nfor lo,hi in [(14500,21000),(15000,20500),(15500,20500),(14500,20000),(15000,20000)]:\n    m=np.logical_and(x>=lo,x<=hi); xx=x[m]; yy=y[m]\n    p0=np.array([13000, 16250,150,3000, 17650,150,7000, 19200,500,70000],float)\n    lb=[0,15800,10,0,16800,10,0,18500,10,0]\n    ub=[30000,16800,1000,30000,18200,1000,50000,19800,3000,120000]\n    r=least_squares(lambda p:(model3(p,xx)-yy),p0,bounds=(lb,ub),x_scale=np.maximum(np.abs(p0),1),max_nfev=100000)\n    pred=model3(r.x,xx); rmse=np.sqrt(np.mean((pred-yy)**2))\n    print('\\nwindow',lo,hi,'n',len(xx),'success',r.success,'cost',r.cost,'rmse',rmse)\n    print('params',r.x)\n    print('max abs residual',np.max(np.abs(pred-yy)))\n\ndef mod_peak(p,xx,order):\n    xref=xx.mean(); z=(xx-xref)/1000\n    out=p[0]+p[1]*z\n    idx=2\n    if order>=2: out=out+p[2]*z*z; idx=3\n    x0,g,A=p[idx:idx+3]\n    return out+lor(xx,x0,g,A)\nfor name,cen,windows in [('2D',16250,[(15000,17000),(15200,17000),(15500,16900),(15700,16800),(15800,16700)]),('G',17600,[(16500,18500),(16800,18500),(17000,18500),(16800,18200),(17000,18100)])]:\n    print('\\n###',name)\n    for lo,hi in windows:\n        m=np.logical_and(x>=lo,x<=hi); xx=x[m]; yy=y[m]\n        for order in [1,2]:\n            prefix_lo=[-1e5,-1e5]+([-1e5] if order==2 else [])\n            prefix_hi=[1e5,1e5]+([1e5] if order==2 else [])\n            center_bounds=([15800,10,0],[16800,1000,50000]) if name=='2D' else ([16800,10,0],[18200,1000,50000])\n            bounds=(prefix_lo+center_bounds[0],prefix_hi+center_bounds[1])\n            p0=[float(np.median(yy)),float((yy[-1]-yy[0])/((xx[-1]-xx[0])/1000))]+([0] if order==2 else [])+[cen,150,max(1000,float(yy.max()-yy.min()))]\n            r=least_squares(lambda p:mod_peak(p,xx,order)-yy,p0,bounds=bounds,x_scale='jac',max_nfev=100000)\n            rmse=np.sqrt(np.mean((mod_peak(r.x,xx,order)-yy)**2))\n            print('win',lo,hi,'ord',order,'n',len(xx),'rmse',round(float(rmse),2),'p',np.round(r.x,3))\nPY\npython /tmp/analyze.py",
  "cwd": "/app",
  "wait_ms": 10000
}
