[工具调用 1/1] exec  (call_id=call_yJ0d0It6aRrb0IdknmCX8JZa)
参数:
{
  "command": "python - <<'PY'\nfrom pathlib import Path\nrows=[]\nfor line in Path('/app/graphene.dat').read_text().splitlines():\n    a,b=line.split('\\t'); rows.append((float(a.replace(',','.')),float(b.replace(',','.'))))\n# summarize equal x windows\nfor lo,hi in [(1600,1800),(1800,2200),(2200,2500),(2500,2900),(2900,3300),(3300,4000),(4000,6000),(6000,10000),(10000,16000),(16000,18000),(18000,20000),(20000,30000),(30000,48000)]:\n s=[r for r in rows if lo<=r[0]<hi]\n if not s: continue\n im=max(range(len(s)),key=lambda i:s[i][1]);\n print(f'{lo:5}-{hi:5}: n={len(s):4} ymin={min(y for x,y in s):9.2f} ymax={s[im][1]:9.2f}@{s[im][0]:10.3f} avg={sum(y for x,y in s)/len(s):9.2f}')\n# local extrema after centered moving averages by point count, x under 5000\nys=[y for x,y in rows]\nfor radius in [2,5,10,20,40]:\n sm=[]\n # prefix sums\n ps=[0]\n for y in ys: ps.append(ps[-1]+y)\n for i in range(len(rows)):\n  a=max(0,i-radius); b=min(len(rows),i+radius+1); sm.append((ps[b]-ps[a])/(b-a))\n peaks=[]\n for i in range(1,len(rows)-1):\n  if rows[i][0] < 5000 and sm[i]>sm[i-1] and sm[i]>=sm[i+1]: peaks.append((sm[i],rows[i][0],ys[i],i+1))\n print('\\nradius',radius,'top local smoothed peaks x<5000')\n for z in sorted(peaks,reverse=True)[:15]: print(' sm=%9.2f x=%9.3f raw=%9.2f line=%d'%z)\n# print points near expected windows sampled every ~10 cm-1\nfor center in [2700,2680,2650,2600,2000,1800,1700]:\n near=min(range(len(rows)),key=lambda i:abs(rows[i][0]-center))\n print('near',center,'line',near+1,'point',rows[near])\nPY",
  "cwd": "/app",
  "wait_ms": 10000
}
