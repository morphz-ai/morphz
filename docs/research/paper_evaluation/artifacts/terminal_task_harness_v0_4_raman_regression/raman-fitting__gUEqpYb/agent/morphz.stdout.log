参数:
{
  "command": "cat > /tmp/baseline.py <<'PY'\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.optimize import least_squares\nrows=[]\nfor line in Path('/app/graphene.dat').read_text().splitlines():\n a,b=line.split('\\t'); rows.append((float(a.replace(',','.')),float(b.replace(',','.'))))\na=np.array(rows); q=np.argsort(a[:,0]); x=a[q,0]; y=a[q,1]\n\ndef ray(x,c,g,A,p): return A/(1+(np.abs((x-c)/g))**p)\ndef base(par,xx,order):\n z=(xx-18000)/5000\n out=sum(par[k]*z**k for k in range(order+1))\n j=order+1\n return out+ray(xx,*par[j:j+4])\n\nfit_ranges=[(13000,23000),(14000,23000),(14500,22000),(15000,22000)]\n# exclude expected graphene bands and saturated top\nfor ran in fit_ranges:\n for gex in [(16900,18000),(17000,17800),(17100,17700),(17200,18000)]:\n  for dex in [(15800,16700),(15900,16500)]:\n   for order in [0,1,2,3]:\n    m=np.logical_and(x>=ran[0],x<=ran[1])\n    m=np.logical_and(m,np.logical_or(x<gex[0],x>gex[1]))\n    m=np.logical_and(m,np.logical_or(x<dex[0],x>dex[1]))\n    # Exclude saturated core; fitting tails gives profile\n    m=np.logical_and(m,np.logical_or(x<18900,x>19550))\n    xx=x[m]; yy=y[m]\n    p0=np.array([12000]+[0]*order+[19200,500,80000,2],float)\n    lb=np.array([-1e5]*(order+1)+[18800,50,0,0.5],float)\n    ub=np.array([1e5]*(order+1)+[19600,3000,200000,6],float)\n    r=least_squares(lambda p:base(p,xx,order)-yy,p0,bounds=(lb,ub),x_scale='jac',loss='soft_l1',f_scale=300,max_nfev=100000)\n    pred=base(r.x,xx,order); rmse=np.sqrt(np.mean((pred-yy)**2))\n    # residuals in candidate windows\n    mg=np.logical_and(x>=16800,x<=18100); md=np.logical_and(x>=15600,x<=16800)\n    rg=y[mg]-base(r.x,x[mg],order); rd=y[md]-base(r.x,x[md],order)\n    # summarize max residual positions\n    ig=np.argmax(rg); id=np.argmax(rd)\n    print('range',ran,'gex',gex,'dex',dex,'ord',order,'rmse',round(rmse,1),'ray',np.round(r.x[order+1:],1),'Gmax',round(x[mg][ig],1),round(rg[ig],1),'2Dmax',round(x[md][id],1),round(rd[id],1))\n print()\n\n# One selected set detailed residuals for several orders\nprint('\\nDETAIL')\nran=(14000,23000);gex=(17000,17800);dex=(15800,16700)\nfor order in [0,1,2,3]:\n m=np.logical_and(x>=ran[0],x<=ran[1]);m=np.logical_and(m,np.logical_or(x<gex[0],x>gex[1]));m=np.logical_and(m,np.logical_or(x<dex[0],x>dex[1]));m=np.logical_and(m,np.logical_or(x<18900,x>19550))\n xx=x[m];yy=y[m];p0=np.array([12000]+[0]*order+[19200,500,80000,2],float);lb=np.array([-1e5]*(order+1)+[18800,50,0,.5]);ub=np.array([1e5]*(order+1)+[19600,3000,200000,6])\n r=least_squares(lambda p:base(p,xx,order)-yy,p0,bounds=(lb,ub),x_scale='jac',loss='soft_l1',f_scale=300,max_nfev=100000)\n print('\\norder',order,'params',r.x)\n mm=np.logical_and(x>=15500,x<=18200)\n for xi,yi,bi in zip(x[mm],y[mm],base(r.x,x[mm],order)): print(f'{xi:9.1f} y={yi:9.1f} b={bi:9.1f} r={yi-bi:8.1f}')\nPY\npython /tmp/baseline.py > /tmp/baseline.out\nsed -n '1,220p' /tmp/baseline.out",
  "cwd": "/app",
  "wait_ms": 10000
}
