{
  "command": "python - <<'PY'\nfrom pathlib import Path\nxs=[]; ys=[]\nfor line in Path('/app/graphene.dat').read_text().splitlines():\n a,b=line.split('\\t'); xs.append(float(a.replace(',','.'))); ys.append(float(b.replace(',','.')))\nn=len(xs)\n# linear regression index -> 1/x\nSx=sum(range(n)); Sy=sum(1/x for x in xs); Sxx=sum(i*i for i in range(n)); Sxy=sum(i*(1/xs[i]) for i in range(n))\nb=(n*Sxy-Sx*Sy)/(n*Sxx-Sx*Sx); a=(Sy-b*Sx)/n\nprint('1/x =',a,'+',b,'i; inferred x=A/(i+c)',1/b,a/b)\nerrs=[1/xs[i]-(a+b*i) for i in range(n)]\nprint('residual inverse max',max(map(abs,errs)),'rms',(sum(e*e for e in errs)/n)**.5)\n# predicted residual x selected\nfor i in [0,30,117,500,1000,1500,2000,2500,3000,3564]:\n pred=1/(a+b*i)\n print(i+1,xs[i],pred,xs[i]-pred,ys[i])\nPY",
  "cwd": "/app",
  "wait_ms": 10000
}
