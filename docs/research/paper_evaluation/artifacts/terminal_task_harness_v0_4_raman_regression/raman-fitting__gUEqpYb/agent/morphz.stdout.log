{
  "command": "python - <<'PY'\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.optimize import least_squares\nx=[]\nfor line in Path('/app/graphene.dat').read_text().splitlines():\n a,b=line.split('\\t'); x.append(float(a.replace(',','.')))\nx=np.array(x); i=np.arange(len(x),dtype=float)\nfor subset in [(0,len(x)),(500,len(x)),(1000,len(x)),(1500,len(x)),(2000,len(x)),(2500,len(x))]:\n lo,hi=subset; ii=i[lo:hi]; xx=x[lo:hi]\n for init in [(0,3.5e6,75),(19000,-1e7,100),(-19000,1e7,100)]:\n  try:\n   r=least_squares(lambda p:p[0]+p[1]/(ii+p[2])-xx,init,max_nfev=100000,x_scale='jac')\n   pred=r.x[0]+r.x[1]/(ii+r.x[2]); rmse=np.sqrt(np.mean((pred-xx)**2))\n   print(subset,'init',init,'p',r.x,'rmse',rmse,'max',np.max(np.abs(pred-xx)))\n  except Exception as e: print(e)\n print()\nPY",
  "cwd": "/app",
  "wait_ms": 10000
}
