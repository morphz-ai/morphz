[工具调用 1/1] exec  (call_id=call_FRaVB52a6cGZa4Vb3GJqtvRf)
参数:
{
  "command": "python - <<'PY'\nfrom pathlib import Path\nimport math\nrows=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n    a,b=line.split('\\t'); rows.append((1e7/float(a.replace(',','.')),float(b.replace(',','.'))))\nrows.sort()\n\ndef solve4(A,b):\n    n=len(b); q=[A[i][:]+[b[i]] for i in range(n)]\n    for i in range(n):\n        k=max(range(i,n),key=lambda z:abs(q[z][i])); q[i],q[k]=q[k],q[i]\n        p=q[i][i]\n        if abs(p)<1e-15:return None\n        for j in range(i,n+1):q[i][j]/=p\n        for k in range(n):\n            if k==i:continue\n            p=q[k][i]\n            for j in range(i,n+1):q[k][j]-=p*q[i][j]\n    return [q[i][-1] for i in range(n)]\n\ndef linear_at(data,x0,g):\n    # offset + amplitude*Lorentzian\n    sl=sy=sll=sly=0.0; n=len(data)\n    for x,y in data:\n        l=1/(1+((x-x0)/g)**2)\n        sl+=l; sy+=y; sll+=l*l; sly+=l*y\n    den=n*sll-sl*sl\n    off=(sy*sll-sl*sly)/den\n    amp=(n*sly-sl*sy)/den\n    sse=sum((y-off-amp/(1+((x-x0)/g)**2))**2 for x,y in data)\n    return sse,off,amp\n\ndef fit(lo,hi,c,g):\n    d=[v for v in rows if lo<=v[0]<=hi]\n    # coordinate descent + grid refinements guaranteed\n    best=(1e300,None,None,None,None)\n    xc=c; gc=g\n    # broad grid then refine\n    for sx,sg in [(5,2),(1,.4),(.2,.08),(.04,.016),(.008,.0032),(.0016,.00064)]:\n        cur=best\n        cx=xc if best[1] is None else best[1]; cg=gc if best[2] is None else best[2]\n        for ix in range(-10,11):\n            x0=cx+ix*sx\n            for ig in range(-10,11):\n                gg=cg+ig*sg\n                if gg<=0:continue\n                sse,off,amp=linear_at(d,x0,gg)\n                if sse<cur[0]:cur=(sse,x0,gg,off,amp)\n        best=cur\n    return len(d),best\nfor name,lo,hi,c,g in [\n ('G',1450,1700,1580,9),('G',1500,1650,1580,9),('G',1500,1700,1580,9),('G',1480,1680,1580,9),\n ('2D',2450,2900,2670,18),('2D',2500,2900,2670,18),('2D',2500,2850,2670,18),('2D',2520,2820,2670,18)]:\n n,b=fit(lo,hi,c,g); sse,x0,gam,off,amp=b\n print(name,lo,hi,'n',n,'x0',x0,'gamma',gam,'amp',amp,'offset',off,'rmse',(sse/n)**.5)\nPY",
  "cwd": ".",
  "wait_ms": 10000
}
