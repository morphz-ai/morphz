参数:
{
  "command": "cat > /tmp/fit.py <<'PY'\nfrom pathlib import Path\nimport math\nrows=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n a,b=line.split('\\t'); raw=float(a.replace(',','.')); y=float(b.replace(',','.'))\n rows.append((1e7/raw,y,raw))\nrows.sort()\n\ndef solve_linear(M,v):\n    n=len(v); A=[M[i][:]+[v[i]] for i in range(n)]\n    for i in range(n):\n        k=max(range(i,n),key=lambda k:abs(A[k][i]))\n        A[i],A[k]=A[k],A[i]\n        if abs(A[i][i])<1e-14: return None\n        q=A[i][i]\n        for j in range(i,n+1): A[i][j]/=q\n        for k in range(n):\n            if k==i: continue\n            q=A[k][i]\n            for j in range(i,n+1): A[k][j]-=q*A[i][j]\n    return [A[i][n] for i in range(n)]\n\ndef linfit(cols, ys):\n    p=len(cols[0]); M=[[0.0]*p for _ in range(p)]; v=[0.0]*p\n    for c,y in zip(cols,ys):\n        for i in range(p):\n            v[i]+=c[i]*y\n            for j in range(p): M[i][j]+=c[i]*c[j]\n    beta=solve_linear(M,v)\n    if beta is None: return float('inf'),None\n    sse=sum((y-sum(b*q for b,q in zip(beta,c)))**2 for c,y in zip(cols,ys))\n    return sse,beta\n\ndef objective(data, x0, logg, baseline='const', shape='lor'):\n    g=math.exp(logg)\n    cols=[]; ys=[]\n    for x,y,_ in data:\n        d=(x-x0)/g\n        if shape=='lor': l=1/(1+d*d)\n        elif shape=='gauss': l=math.exp(-0.5*d*d)\n        else: raise ValueError\n        if baseline=='const': c=[1,l]\n        elif baseline=='linear': c=[1,x-x0,l]\n        elif baseline=='quad': c=[1,x-x0,(x-x0)**2,l]\n        cols.append(c);ys.append(y)\n    return linfit(cols,ys)\n\ndef nm(data, c0,g0,baseline='const',shape='lor'):\n    # Nelder Mead x0, logg\n    def f(p): return objective(data,p[0],p[1],baseline,shape)[0]\n    simplex=[[c0,math.log(g0)],[c0+max(1,g0*.08),math.log(g0)],[c0,math.log(g0)+.08]]\n    vals=[f(p) for p in simplex]\n    for it in range(500):\n        order=sorted(range(3),key=lambda i:vals[i]); simplex=[simplex[i] for i in order];vals=[vals[i] for i in order]\n        a,b,w=simplex; fa,fb,fw=vals\n        c=[(a[0]+b[0])/2,(a[1]+b[1])/2]\n        r=[c[0]+(c[0]-w[0]),c[1]+(c[1]-w[1])]; fr=f(r)\n        if fr<fa:\n            e=[c[0]+2*(r[0]-c[0]),c[1]+2*(r[1]-c[1])];fe=f(e)\n            if fe<fr: simplex[2],vals[2]=e,fe\n            else: simplex[2],vals[2]=r,fr\n        elif fr<fb:\n            simplex[2],vals[2]=r,fr\n        else:\n            if fr<fw: cc=[c[0]+.5*(r[0]-c[0]),c[1]+.5*(r[1]-c[1])]\n            else: cc=[c[0]+.5*(w[0]-c[0]),c[1]+.5*(w[1]-c[1])]\n            fc=f(cc)\n            if fc<fw: simplex[2],vals[2]=cc,fc\n            else:\n                simplex[1]=[a[0]+.5*(simplex[1][0]-a[0]),a[1]+.5*(simplex[1][1]-a[1])]\n                simplex[2]=[a[0]+.5*(simplex[2][0]-a[0]),a[1]+.5*(simplex[2][1]-a[1])]\n                vals[1]=f(simplex[1]);vals[2]=f(simplex[2])\n        if max(abs(simplex[i][0]-simplex[0][0]) for i in range(3))<1e-9 and max(abs(simplex[i][1]-simplex[0][1]) for i in range(3))<1e-10: break\n    order=sorted(range(3),key=lambda i:vals[i]); p=simplex[order[0]]\n    sse,beta=objective(data,p[0],p[1],baseline,shape)\n    return p[0],math.exp(p[1]),beta,sse,len(data)\n\nfor name,c,ranges,g0 in [\n ('G',1580,[(1450,1710),(1480,1680),(1500,1660),(1520,1640),(1540,1620),(1550,1610),(1560,1600)],20),\n ('2D',2670,[(2450,2900),(2500,2850),(2520,2820),(2550,2790),(2580,2760),(2600,2740),(2620,2720),(2630,2710)],30)]:\n print('\\n###',name)\n for lo,hi in ranges:\n  data=[r for r in rows if lo<=r[0]<=hi]\n  for baseline in ['const','linear','quad']:\n   out=nm(data,c,g0,baseline,'lor')\n   x0,g,beta,sse,n=out\n   # offset at x0 beta[0], amp last\n   print(f'{lo}-{hi} {baseline:6s} n={n:3d} x0={x0:.6f} g={g:.6f} off={beta[0]:.4f} amp={beta[-1]:.4f} rmse={(sse/n)**.5:.3f}')\n  print()\nPY\npython /tmp/fit.py",
  "cwd": ".",
  "wait_ms": 10000
}
