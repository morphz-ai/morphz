{
  "command": "python - <<'PY'\nfrom pathlib import Path\nimport numpy as np\np=Path('graphene.dat')\nrows=[]\nfor line in p.read_text().splitlines():\n    a,b=line.split('\\t')\n    rows.append((float(a.replace(',','.')),float(b.replace(',','.'))))\na=np.array(rows)\nx,y=a[:,0],a[:,1]\nprint('shape',a.shape,'x',x.min(),x.max(),'y',y.min(),y.max())\n# global top points\nidx=np.argsort(y)[-30:][::-1]\nprint('top points:')\nfor i in idx[:20]: print(i+1, x[i], y[i])\n# binned max/median to see features\nfor lo,hi in [(1600,1800),(1800,2200),(2200,2500),(2500,2900),(2900,3300),(3300,4500),(4500,8000),(8000,15000),(15000,25000),(25000,50000)]:\n m=(x>=lo)&(x<hi)\n if m.any():\n  j=np.where(m)[0][np.argmax(y[m])]\n  print((lo,hi),'n',m.sum(),'max',x[j],y[j],'median',np.median(y[m]))\nPY",
  "cwd": ".",
  "wait_ms": 10000
}
