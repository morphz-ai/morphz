[工具调用 1/1] exec  (call_id=call_8vIYVMZLBEnhz3mekaPGIBZK)
参数:
{
  "command": "python - <<'PY'\n# generalized Lorentzian + polynomial background fits on inverse-wavenumber x\nfrom pathlib import Path\nimport math\nrows=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n a,b=line.split('\\t'); rows.append((1e7/float(a.replace(',','.')),float(b.replace(',','.'))))\nrows.sort()\ndef solve(M,v):\n n=len(v); A=[M[i][:]+[v[i]] for i in range(n)]\n for i in range(n):\n  k=max(range(i,n),key=lambda z:abs(A[z][i])); A[i],A[k]=A[k],A[i]\n  if abs(A[i][i])<1e-20:return None\n  q=A[i][i]; A[i]=[z/q for z in A[i]]\n  for k in range(n):\n   if k!=i:\n    q=A[k][i]; A[k]=[A[k][j]-q*A[i][j] for j in range(n+1)]\n return [A[i][-1] for i in range(n)]\ndef fitlin(C,Y):\n p=len(C[0]);M=[[0.0]*p for _ in range(p)];v=[0.0]*p\n for c,y in zip(C,Y):\n  for i in range(p):\n   v[i]+=c[i]*y\n   for j in range(p):M[i][j]+=c[i]*c[j]\n b=solve(M,v)\n if b is None:return 1e99,None\n return sum((y-sum(q*z for q,z in zip(b,c)))**2 for c,y in zip(C,Y)),b\ndef obj(data,x0,lg,deg):\n g=math.exp(lg); C=[];Y=[]\n scale=max(abs(x-x0) for x,y in data)\n for x,y in data:\n  t=(x-x0)/scale; L=1/(1+((x-x0)/g)**2)\n  C.append([t**j for j in range(deg+1)]+[L]);Y.append(y)\n return fitlin(C,Y)\ndef nm(data,c,g,deg):\n def f(p):return obj(data,p[0],p[1],deg)[0]\n s=[[c,math.log(g)],[c+1,math.log(g)],[c,math.log(g)+.08]];v=list(map(f,s))\n for _ in range(800):\n  z=sorted(range(3),key=lambda i:v[i]);s=[s[i] for i in z];v=[v[i] for i in z];a,b,w=s;fa,fb,fw=v\n  m=[(a[0]+b[0])/2,(a[1]+b[1])/2];r=[2*m[0]-w[0],2*m[1]-w[1]];fr=f(r)\n  if fr<fa:\n   e=[3*m[0]-2*w[0],3*m[1]-2*w[1]];fe=f(e);s[2],v[2]=(e,fe) if fe<fr else (r,fr)\n  elif fr<fb:s[2],v[2]=r,fr\n  else:\n   cc=[m[i]+.5*((r if fr<fw else w)[i]-m[i]) for i in range(2)];fc=f(cc)\n   if fc<fw:s[2],v[2]=cc,fc\n   else:\n    s[1]=[(a[i]+s[1][i])/2 for i in range(2)];s[2]=[(a[i]+s[2][i])/2 for i in range(2)];v[1]=f(s[1]);v[2]=f(s[2])\n  if max(abs(s[i][0]-s[0][0]) for i in range(3))<1e-8 and max(abs(s[i][1]-s[0][1]) for i in range(3))<1e-9:break\n z=min(range(3),key=lambda i:v[i]);x0,lg=s[z];ss,b=obj(data,x0,lg,deg)\n return x0,math.exp(lg),b[-1],b[0],(ss/len(data))**.5,ss\nfor name,c,g,ranges in [('G',1580,9,[(1450,1710),(1480,1680),(1500,1660)]),('2D',2670,18,[(2400,2950),(2450,2900),(2500,2850),(2520,2820),(2550,2790)])]:\n print('\\n',name)\n for lo,hi in ranges:\n  d=[q for q in rows if lo<=q[0]<=hi]\n  print('window',lo,hi,'n',len(d))\n  for deg in range(0,7):\n   x0,gam,amp,off,rmse,ss=nm(d,c,g,deg)\n   k=deg+4; aic=len(d)*math.log(ss/len(d))+2*k\n   print(f' d{deg}: x0 {x0:.5f} hwhm {gam:.5f} fwhm {2*gam:.5f} amp {amp:.2f} off {off:.2f} rmse {rmse:.2f} AIC {aic:.1f}')\nPY",
  "cwd": ".",
  "wait_ms": 10000
