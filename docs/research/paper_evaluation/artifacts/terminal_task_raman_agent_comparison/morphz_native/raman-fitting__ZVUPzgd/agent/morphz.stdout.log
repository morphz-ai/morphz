参数:
{
  "command": "python - <<'PY'\nfrom pathlib import Path\nimport math\nr=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n a,b=line.split('\\t');r.append((1e7/float(a.replace(',','.')),float(b.replace(',','.'))))\nr.sort()\n# solve direct normal equations\ndef solve(A,b):\n n=len(b); a=[A[i][:]+[b[i]] for i in range(n)]\n for i in range(n):\n  k=max(range(i,n),key=lambda z:abs(a[z][i]));a[i],a[k]=a[k],a[i]\n  q=a[i][i]\n  for j in range(i,n+1):a[i][j]/=q\n  for k in range(n):\n   if k!=i:\n    q=a[k][i]\n    for j in range(i,n+1):a[k][j]-=q*a[i][j]\n return [a[i][-1] for i in range(n)]\nfor lo,hi,x0,g in [(2550,2790,2670.29605,17.86525),(2450,2900,2670.33534,16.7774),(2500,2850,2670.29949,17.20336)]:\n d=[q for q in r if lo<=q[0]<=hi]\n C=[];Y=[]\n for x,y in d:C.append([1,x-x0,1/(1+((x-x0)/g)**2)]);Y.append(y)\n p=3;M=[[sum(c[i]*c[j] for c in C) for j in range(p)] for i in range(p)];v=[sum(c[i]*y for c,y in zip(C,Y)) for i in range(p)]\n b=solve(M,v)\n print('\\n',lo,hi,'beta',b)\n for x in [lo,x0,hi]:\n  base=b[0]+b[1]*(x-x0);peak=b[2]/(1+((x-x0)/g)**2)\n  print(x,'base',base,'peak',peak,'total',base+peak)\n # sideband average residual baseline\n for a,z in [(lo,lo+30),(lo+30,lo+60),(hi-60,hi-30),(hi-30,hi)]:\n  ss=[(x,y) for x,y in d if a<=x<=z]\n  print((a,z),sum(y for x,y in ss)/len(ss), 'model',sum(b[0]+b[1]*(x-x0)+b[2]/(1+((x-x0)/g)**2) for x,y in ss)/len(ss))\nPY",
  "cwd": ".",
  "wait_ms": 10000
}
