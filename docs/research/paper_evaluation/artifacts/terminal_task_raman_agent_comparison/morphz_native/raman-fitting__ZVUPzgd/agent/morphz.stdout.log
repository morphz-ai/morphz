  "command": "python - <<'PY'\nfrom pathlib import Path\nrows=[]\nfor n,line in enumerate(Path('graphene.dat').read_text().splitlines(),1):\n a,b=line.split('\\t'); rows.append((n,float(a.replace(',','.')),float(b.replace(',','.'))))\nfor lo,hi in [(19500,18500),(18300,17500),(17800,17200),(17100,16500),(16800,16000),(16000,15000)]:\n s=[r for r in rows if hi<=r[1]<=lo]\n print('\\nrange',hi,lo,'n',len(s))\n # print every and local maxima\n top=sorted(s,key=lambda r:r[2],reverse=True)[:10]\n print('top',[(round(x,3),round(y,1),n) for n,x,y in top])\n # local maxima using original indices\n for j in range(1,len(s)-1):\n  if s[j][2]>s[j-1][2] and s[j][2]>s[j+1][2] and s[j][2]>sum(q[2] for q in s)/len(s)*1.1:\n   print(' local',s[j])\nPY",
