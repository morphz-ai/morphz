参数:
{
  "command": "python - <<'PY'\n# Four-parameter Lorentzian constant-background fits over common Raman windows.\nfrom pathlib import Path\nimport math\nr=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n a,b=line.split('\\t');r.append((1e7/float(a.replace(',','.')),float(b.replace(',','.'))))\nr.sort()\ndef lin(d,c,g):\n L=[1/(1+((x-c)/g)**2) for x,y in d];Y=[y for x,y in d];n=len(d);sl=sum(L);sy=sum(Y);sll=sum(q*q for q in L);sly=sum(q*y for q,y in zip(L,Y));den=n*sll-sl*sl\n off=(sy*sll-sl*sly)/den;amp=(n*sly-sl*sy)/den;sse=sum((y-off-amp*l)**2 for l,y in zip(L,Y));return sse,off,amp\ndef fit(lo,hi,c,g):\n d=[q for q in r if lo<=q[0]<=hi];best=(1e99,c,g,0,0)\n for sx,sg in [(3,1),(.5,.2),(.1,.04),(.02,.008),(.004,.0016),(.0008,.00032)]:\n  _,bc,bg,_,_=best\n  for i in range(-12,13):\n   for j in range(-12,13):\n    cc=bc+i*sx;gg=bg+j*sg\n    if gg<=0:continue\n    s,o,a=lin(d,cc,gg)\n    if s<best[0]:best=(s,cc,gg,o,a)\n return len(d),best\nfor lo,hi in [(1450,1650),(1480,1680),(1500,1700),(1500,1650),(1520,1640),(1540,1620),(1550,1610)]:\n n,b=fit(lo,hi,1580,9);print('G',lo,hi,n,b[1:],'rmse',(b[0]/n)**.5)\nfor lo,hi in [(2450,2900),(2500,2900),(2500,2850),(2550,2850),(2550,2800),(2580,2800),(2600,2800),(2600,2780),(2600,2760),(2620,2740)]:\n n,b=fit(lo,hi,2670,18);print('2D',lo,hi,n,b[1:],'rmse',(b[0]/n)**.5)\nPY",
  "cwd": ".",
  "wait_ms": 10000
}
