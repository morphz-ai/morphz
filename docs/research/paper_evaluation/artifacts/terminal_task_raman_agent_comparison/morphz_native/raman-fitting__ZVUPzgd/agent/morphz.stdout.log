{
  "command": "python - <<'PY'\nfrom pathlib import Path\nfrom statistics import median\nrows=[]\nfor n,line in enumerate(Path('graphene.dat').read_text().splitlines(),1):\n a,b=line.split('\\t'); rows.append((float(a.replace(',','.')),float(b.replace(',','.'))))\nx=[r[0] for r in rows]; y=[r[1] for r in rows]; n=len(y)\nfor w in [3,5,10,20,40,80,160]:\n vals=[]\n for i in range(w,n-w):\n  # line interpolation between medians of flanking bands\n  l=median(y[i-w:i-max(1,w//2)])\n  r=median(y[i+max(1,w//2):i+w])\n  base=(l+r)/2\n  vals.append((y[i]-base,i,base))\n # separated top residuals\n vals.sort(reverse=True)\n chosen=[]\n for res,i,b in vals:\n  if all(abs(i-j)>w//2 for _,j,_ in chosen): chosen.append((res,i,b))\n  if len(chosen)>=15: break\n print('\\nwindow',w)\n for res,i,b in chosen:\n  print(i+1,'x',round(x[i],4),'y',round(y[i],2),'base',round(b,2),'res',round(res,2),'ratio',round(y[i]/b,3) if b else None)\nPY",
  "cwd": ".",
  "wait_ms": 10000
}
