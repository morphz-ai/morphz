{
  "command": "python - <<'PY'\nfrom pathlib import Path\nfrom statistics import median\nrows=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n    a,b=line.split('\\t')\n    rows.append((float(a.replace(',','.')),float(b.replace(',','.'))))\nx=[r[0] for r in rows]; y=[r[1] for r in rows]\nprint('shape',len(rows),'x',min(x),max(x),'y',min(y),max(y))\nidx=sorted(range(len(y)),key=lambda i:y[i],reverse=True)[:30]\nprint('top points:')\nfor i in idx[:20]: print(i+1,x[i],y[i])\nfor lo,hi in [(1600,1800),(1800,2200),(2200,2500),(2500,2900),(2900,3300),(3300,4500),(4500,8000),(8000,15000),(15000,25000),(25000,50000)]:\n inds=[i for i,v in enumerate(x) if lo<=v<hi]\n if inds:\n  j=max(inds,key=lambda i:y[i])\n  print((lo,hi),'n',len(inds),'max',x[j],y[j],'median',median(y[i] for i in inds))\nPY",
  "cwd": ".",
  "wait_ms": 10000
}
