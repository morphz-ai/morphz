+/* Isolated Morphz probe diagnostic only: read metadata, preserve caller errno.
+ * Never set dumpability, credentials, capabilities, namespace or policy.
+ * Emit no file contents or environment; only the three fixed ID-map paths.
+ */
+static void
+morphz_map_diagnostic (int         dirfd,
+                      const char *path,
+                      const char *phase,
+                      int         fd,
+                      int         result,
+                      int         operation_errno)
+{
+  int saved_errno = errno;
+  struct stat metadata = { 0 };
+  int stat_result;
+  int stat_errno;
+  FILE *status;
+  char line[512];
+
+  if (strcmp (path, "uid_map") != 0 &&
+      strcmp (path, "gid_map") != 0 &&
+      strcmp (path, "setgroups") != 0)
+    return;
+
+  stat_result = fstatat (dirfd, path, &metadata, 0);
+  stat_errno = stat_result < 0 ? errno : 0;
+  fprintf (stderr,
+           "DYNAMIC_BWRAP_MAP phase=%s path=%s pid=%ld ppid=%ld "
+           "uid=%ld euid=%ld gid=%ld egid=%ld dumpable=%d "
+           "dirfd=%d fd=%d result=%d operation_errno=%d "
+           "stat_result=%d stat_errno=%d owner=%ld group=%ld mode=%lo\n",
+           phase, path, (long) getpid (), (long) getppid (),
+           (long) getuid (), (long) geteuid (), (long) getgid (), (long) getegid (),
+           prctl (PR_GET_DUMPABLE, 0, 0, 0, 0),
+           dirfd, fd, result, operation_errno, stat_result, stat_errno,
+           (long) metadata.st_uid, (long) metadata.st_gid,
+           (unsigned long) (metadata.st_mode & 07777));
+  status = fopen ("/proc/self/status", "r");
+  if (status != NULL)
+    {
+      while (fgets (line, sizeof (line), status) != NULL)
+        if (strncmp (line, "Cap", 3) == 0 ||
+            strncmp (line, "Uid:", 4) == 0 ||
+            strncmp (line, "Gid:", 4) == 0 ||
+            strncmp (line, "NoNewPrivs:", 11) == 0)
+          fprintf (stderr, "DYNAMIC_BWRAP_MAP_STATE phase=%s path=%s %s",
+                   phase, path, line);
+      fclose (status);
+    }
+  else
+    fprintf (stderr, "DYNAMIC_BWRAP_MAP_STATE phase=%s path=%s status_errno=%d\n",
+             phase, path, errno);
+  errno = saved_errno;
+}
+
 /* Sets errno on error (!= 0), ENOSPC on short write */
