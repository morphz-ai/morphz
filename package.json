{
  "name": "morphzwork",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Object-centered workspace for human and agent collaboration",
  "engines": {
    "node": ">=24.13.0"
  },
  "dependencies": {
    "lucide-react": "1.42.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.2.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx apps/service/src/main.ts",
    "dev:center": "tsx scripts/development-center.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/service/apps/service/src/main.js",
    "desktop": "electron apps/desktop/main.cjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:desktop-hmr": "node scripts/desktop-hmr-smoke.mjs",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:native-input": "tsx scripts/native-input-smoke.ts",
    "test:desktop-speech": "tsx scripts/desktop-speech-smoke.ts",
    "test:runtime-tools": "tsx scripts/runtime-tools-smoke.ts",
    "test:runtime-identity": "tsx scripts/runtime-identity-smoke.ts",
    "backup:center": "node scripts/backup-center.mjs",
    "format": "prettier --write apps packages scripts tests *.json *.ts",
    "format:check": "prettier --check apps packages scripts tests *.json *.ts"
  },
  "allowScripts": {
    "electron@44.2.0": true,
    "esbuild@0.28.2": true
  }
}
