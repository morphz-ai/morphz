# Morphz 环境变量配置样例
# 请复制本文件并重命名为 .env，并填入您的真实 API 配置

# [必填] 您的大模型 API 密钥
OPENAI_API_KEY=your_openai_api_key_here

# [可选] 自定义大模型代理端点 (如 DeepSeek, 转发器, OneAPI)
# OPENAI_BASE_URL=https://api.deepseek.com

# [可选] 显式 HTTP(S) 代理。Morphz 不自动读取系统代理，以避免宿主代理探测异常
# OPENAI_HTTP_PROXY=http://127.0.0.1:7890

# [可选] Provider 无关的运行时选择；它们高于用户、Profile 和项目配置
# MORPHZ_LLM_PROVIDER=custom
# MORPHZ_LLM_MODEL=deepseek-chat
