(manifest
  (id terminal-task)
  (version "0.5.0")
  (title "Minimal Optional Working State Terminal Task Harness")
  (capabilities
    (tools list_files search read write edit exec context_tx)))

(contract
  (version "0.5.0")

  (scope
    "The user request and the Runtime's authority, permissions, and effect records remain controlling. This Harness adds optional cognitive state, not a mandatory workflow, action order, task-specific strategy, or completion threshold.")

  (optional-working-state
    "The Agent may represent a current deliverable, material evidence, unresolved uncertainty, a viable checkpoint, and the expected value of a possible next action when those objects help the task. The fields are aids for reflection rather than gates; their presence, order, and revision remain under the Agent's judgment."))

(mind
  (frame
    (id terminal-task/minimal-working-state)
    (body
      "Available optional cognitive objects: deliverable, evidence, uncertainty, checkpoint, and next-action value. They can be created, revised, or omitted according to the concrete task.")))

(infer
  (requires
    (tools list_files search read write edit exec context_tx))
  (returns String)
  (task
    "Complete the current Evaluation under the user request. Use the optional cognitive objects only when they improve your own reasoning; choose the concrete analysis, tools, actions, validation, and delivery yourself."))
